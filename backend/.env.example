# Variáveis para rodar a API fora do Docker (npm run dev). Copie para .env e ajuste.
# Valores de desenvolvimento: nunca use estes segredos em produção.

# Banco do docker compose (docker compose up -d db)
DATABASE_URL=postgresql://elevate:elevate@localhost:5432/elevate

# Segredo que assina o JWT da sessão (obrigatório: sem ele a API não sobe)
JWT_SECRET=dev-only-jwt-secret-troque-em-producao

# Opcionais (valores padrão entre parênteses)
# PORT=3000
# Fuso de "leads hoje" e do filtro de período (America/Sao_Paulo)
# APP_TIMEZONE=America/Sao_Paulo
# Limite por IP no POST /api/leads, por minuto; 0 desliga (120)
# LEADS_RATE_LIMIT_PER_MINUTE=120
# Tentativas de login erradas por IP + e-mail a cada 15 minutos (5)
# LOGIN_RATE_LIMIT=5
# Cookie da sessão só em HTTPS (false)
# COOKIE_SECURE=true
# Quantos proxies confiáveis há na frente da API, para ler o IP real (nenhum)
# TRUST_PROXY=1
